@{ ViewBag.Title = "Nhập kho"; }
<h2>Nhập kho sản phẩm</h2>

@using (Html.BeginForm())
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        <label>Chọn sản phẩm:</label>
        @Html.DropDownList("productID", null, new { @class = "form-control" })
    </div>
    <div class="form-group mt-2">
        <label>Số lượng nhập bổ sung:</label>
        <input type="number" name="quantityToAdd" class="form-control" required min="1" />
    </div>
    <button type="submit" class="btn btn-success mt-3">Xác nhận nhập kho</button>
}